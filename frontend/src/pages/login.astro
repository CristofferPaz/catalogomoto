---
import MainLayout from '../layouts/MainLayout.astro';
import LoginForm from '../components/auth/LoginForm.astro';
---
<MainLayout title="Iniciar sesión · SABINO'S MOTORCYCLES">
  <section class="container-power flex min-h-[65vh] items-center justify-center py-12"><div class="w-full max-w-md border-t-4 border-power-red bg-power-graphite p-8 shadow-xl ring-1 ring-power-gunmetal"><p class="text-sm font-bold uppercase tracking-[.2em] text-power-red">Área privada</p><h1 class="mt-2 text-5xl text-power-soft">Iniciar sesión</h1><p class="mt-2 mb-8 text-sm text-power-muted">Ingresa para administrar el catálogo.</p><LoginForm /></div></section>
</MainLayout>
