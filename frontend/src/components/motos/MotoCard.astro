---
import type { Moto } from '../../types/moto.types';
import { displayCategory, imageFor } from '../../types/moto.types';
const { moto } = Astro.props as { moto: Moto };
---
<article class="group overflow-hidden bg-power-graphite shadow-sm ring-1 ring-power-gunmetal transition hover:-translate-y-1 hover:shadow-xl">
  <div class="relative aspect-[4/3] overflow-hidden bg-power-graphite">
    <img src={imageFor(moto)} alt={moto.modelo} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
    <span class="absolute left-3 top-3 bg-power-red px-3 py-1 text-xs font-bold uppercase text-white">{displayCategory(moto.categoria)}</span>
  </div>
  <div class="p-5">
    <p class="text-xs font-semibold uppercase tracking-widest text-zinc-500">{moto.cilindrada} cc</p>
    <h3 class="mt-1 text-3xl">{moto.modelo}</h3>
    <p class="mt-3 text-lg font-bold text-power-red">Bs. {Number(moto.precio).toLocaleString('es-BO')}</p>
    <p class="mt-2 line-clamp-2 min-h-10 text-sm text-power-muted">{moto.descripcion ?? "Descubre este modelo SABINO'S MOTORCYCLES."}</p>
    <a href={`/motos?modelo=${encodeURIComponent(moto.modelo)}`} class="mt-5 inline-flex text-sm font-bold uppercase text-power-red hover:underline">Ver modelo →</a>
  </div>
</article>
